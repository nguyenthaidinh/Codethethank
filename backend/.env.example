APP_NAME="The Unwritten Lesson Gratitude API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8055
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55455
DB_DATABASE=gratitude
DB_USERNAME=gratitude
DB_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=log
BCRYPT_ROUNDS=12
CORS_ALLOWED_ORIGINS=
SUBMIT_PER_MINUTE=120
SUBMIT_PER_HOUR=3000
RECEIPT_PER_MINUTE=30
STAFF_TOKEN_MINUTES=480
ADMIN_SESSION_DRIVER=database
# Set true with HTTPS in production. Local HTTP preview uses false.
ADMIN_SECURE_COOKIE=false
